# Desenvolvimento local. O servidor lê o ambiente do processo, não este arquivo automaticamente.
DATABASE_URL=postgres://forge:forge_local@127.0.0.1:5432/forge
FORGE_PORT=3000
RUST_LOG=info

# Executor
FORGE_DEPLOY_TIMEOUT_SECS=600
FORGE_DOCKER_SOCKET=/var/run/docker.sock
FORGE_CADDY_URL=http://127.0.0.1:2019
FORGE_PROXY_PORT=8080
# FORGE_ASSET_DIR=/caminho/absoluto/para/assets
